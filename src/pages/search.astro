---
export const prerender = false;
import { search } from "emdash";
import Layout from "../diver/Layout.astro";
import Breadcrumb from "../diver/Breadcrumb.astro";

import { getDb } from "emdash/runtime";
import { sql } from "kysely";

const query = Astro.url.searchParams.get("q")?.trim() || "";
const { items: found } = query
	? await search(query, { collections: ["posts", "pages"], limit: 30 })
	: { items: [] as any[] };
// 会員限定のページは、題名だけ出して本文の抜き出し（snippet）は出さない
let restricted = new Set<string>();
try {
	const r = await sql<{ slug: string }>`SELECT slug FROM ec_pages WHERE member_level IS NOT NULL AND member_level != ''`.execute(await getDb());
	restricted = new Set(r.rows.map((x) => x.slug));
} catch {}
const results = found.map((r: any) => (restricted.has(r.slug) ? { ...r, snippet: null, title: `${r.title ?? ""}（会員限定）` } : r));
---

<Layout title={query ? `「${query}」の検索結果` : "検索"} robots="noindex">
	<Breadcrumb items={[{ label: query ? `「${query}」の検索結果` : "検索" }]} />
	<div class="d-archive-head">
		<h1>{query ? `「${query}」の検索結果` : "検索"}</h1>
		<form action="/search" method="get" class="d-search" style="margin-top:10px">
			<input type="search" name="q" value={query} aria-label="検索" />
			<button type="submit">検索</button>
		</form>
	</div>
	{
		query && (results.length > 0 ? (
			<div class="d-card d-page">
				<ol class="d-results">
					{results.map((r: any) => (
						<li>
							<a href={`/${r.slug ?? r.id}/`}>{r.title ?? "(無題)"}</a>
							{r.snippet && <p set:html={r.snippet} />}
						</li>
					))}
				</ol>
			</div>
		) : (
			<div class="d-card d-page">
				「{query}」に一致する記事は見つかりませんでした。
				{[...query.replace(/\s/g, "")].length < 3 && <p>※ 日本語の検索は3文字以上で行ってください（例：「ビザ」→「ビザ延長」）。</p>}
			</div>
		))
	}
</Layout>

<style>
	.d-results { list-style: none; display: grid; gap: 16px; }
	.d-results a { font-weight: 700; font-size: 1.05rem; }
	.d-results p { margin: 4px 0 0; font-size: 0.85rem; color: #666; }
	.d-results :global(mark) { background: #fff3a0; }
</style>
